{
  "name": "punch-list-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p server/tsconfig.json",
    "start:server": "node server/dist/index.js",
    "test": "tsx --test server/src/app.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
